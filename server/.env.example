PORT=3000
DB_PATH=../app.db
DATASET_ROOT=
VIEWER_MAX_MB=100

# Model for question parsing and text reports. Any OpenAI-compatible endpoint works.
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://inference.verda.com/v1
OPENAI_API_KEY=
LLM_MODEL=deepseek-4-1-flash-1017
# Price per 1M tokens, for the cost panel (Verda lists EUR; the UI labels it $)
LLM_PRICE_IN=0.1336
LLM_PRICE_OUT=0.5346

# Alternative: Gemini
# LLM_PROVIDER=google
# GOOGLE_GENERATIVE_AI_API_KEY=
# LLM_MODEL=gemini-2.5-flash
