PORT=3000
DB_PATH=../app.db
# folder holding the dataset, only needed to serve IFC files indexed from it
DATASET_ROOT=
VIEWER_MAX_MB=100

# question parsing model: openai or google
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# optional: OpenAI-compatible proxy
OPENAI_BASE_URL=
# USD per 1M tokens, used for the cost counter
LLM_PRICE_IN=0.4
LLM_PRICE_OUT=1.6
